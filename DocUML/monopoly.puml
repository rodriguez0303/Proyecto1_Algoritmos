' ==========================================

' COMPOSICION - EL HISTORIAL ADMINISTRA SUS NODOS
HistorialTransacciones *-- "0..*" NodoHistorial : contiene

' ASOCIACION - CADA NODO ALMACENA UNA TRANSACCION
NodoHistorial --> "1" Transaccion : transaccion

' AUTOASOCIACIONES - ENLACES DOBLES
NodoHistorial --> "0..1" NodoHistorial : siguiente
NodoHistorial --> "0..1" NodoHistorial : anterior

' DEPENDENCIA - UTILIZA TIPOS DE TRANSACCION
HistorialTransacciones ..> TipoTransaccion : <<use>>

' DEPENDENCIA - UTILIZA ESCRITURA DE ARCHIVOS
HistorialTransacciones ..> FileWriter : <<create>>
HistorialTransacciones ..> PrintWriter : <<create>>


' ==========================================
' CLASE JUEGO
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class Juego {

  ' ATRIBUTOS PRIVADOS
  - Jugadores : ColaCircular<Jugador>
  - TurnoActual : Jugador
  - NumTurno : int
  - NumRonda : int
  - PosicionCola : int
  - Curso : boolean
  - MaxRondas : int
  - Ganador : Jugador
  - Empatados : Jugador[]
  - ContadorTransacciones : int
  - DadosLanzados : boolean
  - Tablero : Tablero
  - Banco : Banco
  - Dado1 : Dado
  - Dado2 : Dado
  - Historial : HistorialTransacciones
  - CartaEnCurso : boolean
  - PagosDiferidos : boolean
  - AlquilerPendiente : Propiedad
  - CartaPendiente : CartaEvento

  ' CONSTRUCTOR PUBLICO
  + Juego(MaxRondas : int)

  ' METODOS PUBLICOS
  + AgregarJugador(Jugador : Jugador) : void
  + IniciarPartida() : void
  + obtenerJugadorActual() : Jugador
  + SiguienteTurno() : void
  + RevisarFinPartida() : boolean
  + finalizarTurno() : void
  + SetPagosDiferidos(Diferidos : boolean) : void
  + EsPagosDiferidos() : boolean
  + DejarAlquilerPendiente(Propiedad : Propiedad) : void
  + DejarCartaPendiente(Carta : CartaEvento) : void
  + HayPagoPendiente() : boolean
  + GetMontoPagoPendiente() : double
  + GetMotivoPagoPendiente() : String
  + CobrarPagoPendiente(Jugador : Jugador) : void
  + lanzarDados() : int
  + registrarDadosFisicos(valorDado1 : int, valorDado2 : int) : int
  + getDadosLanzadosEsteTurno() : boolean
  + MoverJugador(Jugador : Jugador, Pos : int) : void
  + RetrocederJugador(Jugador : Jugador, Pasos : int) : void
  + MoverJugadorA(Jugador : Jugador, Posicion : int) : void
  + EnviarAlD3(Jugador : Jugador) : void
  + RegistrarTransaccion(Transaccion : Transaccion) : void
  + GenerarIdTransaccion() : String
  + finalizarPartida() : void
  + GetGanador() : Jugador
  + HayEmpate() : boolean
  + GetEmpatados() : Jugador[]
  + isEnCurso() : boolean
  + buscarJugadorPorIdentificador(identificador : String) : Jugador
  + obtenerPropiedadActual(jugador : Jugador) : Propiedad
  + comprarPropiedad(jugador : Jugador, propiedad : Propiedad) : void
  + getNumTurno() : int
  + GetNumRonda() : int
  + GetMaxRondas() : int
  + getDado1() : Dado
  + getDado2() : Dado
  + getHistorial() : HistorialTransacciones
  + getBanco() : Banco
  + getTablero() : Tablero

  ' METODOS PRIVADOS
  - AvanzarCola() : Jugador
  - ContarJugadoresActivos() : int
  - PagarPremioSalida(Jugador : Jugador) : void
  - AjustarPosicion(Posicion : int) : int
  - EjecutarCasilla(Jugador : Jugador, Nodo : NodoCasilla) : void
}

}

' ==========================================
' RELACIONES UML DE JUEGO
' ==========================================

' COMPOSICION - JUEGO CREA SU COLA DE TURNOS
Juego *-- "1" ColaCircular : Jugadores

' ASOCIACION - JUGADORES DE LA PARTIDA
Juego --> "0..*" Jugador : participantes

' COMPOSICION - JUEGO CREA EL TABLERO
Juego *-- "1" Tablero : Tablero

' COMPOSICION - JUEGO CREA EL BANCO
Juego *-- "1" Banco : Banco

' COMPOSICION - JUEGO CREA DOS DADOS
Juego *-- "2" Dado : Dado1 y Dado2

' COMPOSICION - JUEGO CREA EL HISTORIAL
Juego *-- "1" HistorialTransacciones : Historial

' ASOCIACION - REFERENCIA A LA PROPIEDAD PENDIENTE
Juego --> "0..1" Propiedad : AlquilerPendiente

' ASOCIACION - REFERENCIA A LA CARTA PENDIENTE
Juego --> "0..1" CartaEvento : CartaPendiente

' DEPENDENCIA - UTILIZA NODOS DEL TABLERO
Juego ..> NodoCasilla : <<use>>

' DEPENDENCIA - EJECUTA CASILLAS
Juego ..> Casilla : <<use>>

' DEPENDENCIA - IDENTIFICA CASILLAS DE EVENTO
Juego ..> CasillaEvento : <<use>>

' DEPENDENCIA - CREA TRANSACCIONES
Juego ..> Transaccion : <<create>>

' DEPENDENCIA - UTILIZA TIPOS DE TRANSACCION
Juego ..> TipoTransaccion : <<use>>

' DEPENDENCIA - CONSULTA CONSTANTES
Juego ..> Constantes : <<use>>


' ==========================================
' CLASE JUGADOR
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class Jugador {

  ' ATRIBUTOS PRIVADOS
  - identificador : String
  - nombre : String
  - saldo : double
  - posicionActual : int
  - activo : boolean
  - PierdeTurno : boolean
  - CartasSalidaD3 : int
  - propiedadesAdquiridas : ListaSimplePropiedad

  ' CONSTRUCTOR PUBLICO
  + Jugador(identificador : String, nombre : String, saldo : double)

  ' METODOS PUBLICOS
  + agregarPropiedad(propiedad : Propiedad) : void
  + getPropiedadesAdquiridas() : ListaSimplePropiedad
  + getIdentificador() : String
  + getNombre() : String
  + setNombre(nombre : String) : void
  + getSaldo() : double
  + getPosicionActual() : int
  + esActivo() : boolean
  + modificarSaldo(monto : double) : void
  + setPosicionActual(nuevaPosicion : int) : void
  + eliminar() : void
  + PerderTurno() : void
  + DebePerderTurno() : boolean
  + ConsumirTurnoPerdido() : void
  + GuardarCartaSalidaD3() : void
  + UsarCartaSalidaD3() : boolean
  + GetCartasSalidaD3() : int
  + CalcularPatrimonio() : double

}

}

' ==========================================
' RELACIONES UML DE JUGADOR
' ==========================================

' COMPOSICION - EL JUGADOR CREA SU LISTA DE PROPIEDADES
Jugador *-- "1" ListaSimplePropiedad : propiedadesAdquiridas

' DEPENDENCIA - UTILIZA OBJETOS PROPIEDAD
Jugador ..> Propiedad : <<use>>


' ==========================================
' CLASE LISTACIRCULARDOBLE
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class "ListaCircularDoble<T>" as ListaCircularDoble {

  ' ATRIBUTOS PRIVADOS
  - Primero : Nodo
  - Ultimo : Nodo
  - Tamaño : int

  ' METODOS PUBLICOS
  + Agregar(Elemento : T) : void
  + ObtenerPrimero() : T
  + Tamaño() : int
  + Vacio() : boolean

}

' ==========================================
' CLASE INTERNA NODO
' ==========================================

class "ListaCircularDoble.Nodo" as NodoListaCircularDoble {

  ' ATRIBUTOS CON ACCESO DE PAQUETE
  ~ Dato : T
  ~ Anterior : Nodo
  ~ Siguiente : Nodo

  ' CONSTRUCTOR CON ACCESO DE PAQUETE
  ~ Nodo(Dato : T)

}

}

' ==========================================
' RELACIONES UML DE LISTACIRCULARDOBLE
' ==========================================

' COMPOSICION - LA LISTA CREA Y CONTIENE SUS NODOS
ListaCircularDoble *-- "0..*" NodoListaCircularDoble : contiene

' AUTOASOCIACION - CADA NODO APUNTA AL ANTERIOR
NodoListaCircularDoble --> "1" NodoListaCircularDoble : Anterior

' AUTOASOCIACION - CADA NODO APUNTA AL SIGUIENTE
NodoListaCircularDoble --> "1" NodoListaCircularDoble : Siguiente



' ==========================================
' CLASE LISTASIMPLEPROPIEDAD
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class ListaSimplePropiedad {

  ' ATRIBUTOS PRIVADOS
  - Primero : Nodo
  - Ultimo : Nodo
  - Tamaño : int

  ' CONSTRUCTOR PUBLICO
  + ListaSimplePropiedad()

  ' METODOS PUBLICOS
  + Agregar(propiedad : Propiedad) : void
  + Obtener(Posicion : int) : Propiedad
  + Eliminar(propiedad : Propiedad) : boolean
  + ObtenerPrimero() : Propiedad
  + Tamaño() : int
  + Vacio() : boolean
  + Vaciar() : void

}

' ==========================================
' CLASE INTERNA NODO
' ==========================================

class "ListaSimplePropiedad.Nodo" as NodoListaSimplePropiedad {

  ' ATRIBUTOS CON ACCESO DE PAQUETE
  ~ Dato : Propiedad
  ~ Siguiente : Nodo

  ' CONSTRUCTOR CON ACCESO DE PAQUETE
  ~ Nodo(Dato : Propiedad)

}

}

' ==========================================
' RELACIONES UML DE LISTASIMPLEPROPIEDAD
' ==========================================

' COMPOSICION - LA LISTA CREA Y ADMINISTRA SUS NODOS
ListaSimplePropiedad *-- "0..*" NodoListaSimplePropiedad : contiene

' ASOCIACION - CADA NODO ALMACENA UNA PROPIEDAD
NodoListaSimplePropiedad --> "1" Propiedad : Dato

' AUTOASOCIACION - CADA NODO APUNTA AL SIGUIENTE
NodoListaSimplePropiedad --> "0..1" NodoListaSimplePropiedad : Siguiente

' DEPENDENCIA - LA LISTA UTILIZA OBJETOS PROPIEDAD
ListaSimplePropiedad ..> Propiedad : <<use>>


' ==========================================
' CLASE MAZOEVENTOS
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class MazoEventos {

  ' ATRIBUTOS PRIVADOS
  - Cartas : ColaCircular<CartaEvento>
  - CartasCreadas : CartaEvento[]
  - CantidadCreadas : int

  ' CONSTANTES PRIVADAS Y ESTATICAS
  - {static} MAX_CARTAS : int = 30 {readOnly}
  - {static} POSICION_COMEDOR : int = 1 {readOnly}
  - {static} POSICION_LAGO : int = 11 {readOnly}
  - {static} POSICION_GYMTEC : int = 13 {readOnly}

  ' CONSTRUCTOR PUBLICO
  + MazoEventos()

  ' METODOS PUBLICOS
  + SacarCarta() : CartaEvento
  + Tamaño() : int

  ' METODOS PRIVADOS
  - CrearCartas() : void
  - AgregarCarta(Descripcion : String, Tipo : TipoEvento, Valor : int) : void
  - MezclarYArmarCola() : void

}

}

' ==========================================
' RELACIONES UML DE MAZOEVENTOS
' ==========================================

' COMPOSICION - EL MAZO CREA SU COLA CIRCULAR
MazoEventos *-- "1" ColaCircular : Cartas

' ASOCIACION - ALMACENA CARTAS DE EVENTO
MazoEventos --> "0..*" CartaEvento : CartasCreadas

' DEPENDENCIA - CREA OBJETOS CARTAEVENTO
MazoEventos ..> CartaEvento : <<create>>

' DEPENDENCIA - UTILIZA LOS TIPOS DE EVENTO
MazoEventos ..> TipoEvento : <<use>>

' DEPENDENCIA - UTILIZA CONSTANTES DEL JUEGO
MazoEventos ..> Constantes : <<use>>

' DEPENDENCIA - MEZCLA LAS CARTAS ALEATORIAMENTE
MazoEventos ..> Random : <<create>>


' ==========================================
' CLASE NODOCASILLA
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class NodoCasilla {

  ' ATRIBUTOS PRIVADOS
  - Casilla : Casilla
  - Anterior : NodoCasilla
  - Siguiente : NodoCasilla

  ' CONSTRUCTOR PUBLICO
  + NodoCasilla(Casilla : Casilla)

  ' METODOS PUBLICOS
  + getCasilla() : Casilla
  + getAnterior() : NodoCasilla
  + getSiguiente() : NodoCasilla
  + setAnterior(N : NodoCasilla) : void
  + setSiguiente(N : NodoCasilla) : void

}

}

' ==========================================
' RELACIONES UML DE NODOCASILLA
' ==========================================

' ASOCIACION - EL NODO ALMACENA UNA CASILLA
NodoCasilla --> "1" Casilla : Casilla

' AUTOASOCIACION - REFERENCIA AL NODO ANTERIOR
NodoCasilla --> "0..1" NodoCasilla : Anterior

' AUTOASOCIACION - REFERENCIA AL NODO SIGUIENTE
NodoCasilla --> "0..1" NodoCasilla : Siguiente


' ==========================================
' CLASE PROPIEDAD
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class Propiedad {

  ' ATRIBUTOS PRIVADOS
  - identificador : String
  - precioCompra : double
  - alquiler : double
  - propietario : Jugador

  ' CONSTRUCTOR PUBLICO
  + Propiedad(identificador : String, nombre : String, precioCompra : double, alquiler : double)

  ' METODOS PUBLICOS
  + getIdentificador() : String
  + getPrecioCompra() : double
  + getAlquiler() : double
  + getPropietario() : Jugador
  + isDisponible() : boolean
  + comprar(jugador : Jugador, juego : Juego) : boolean
  + ejecutar(jugador : Jugador, juego : Juego) : void
  + pagarAlquiler(jugador : Jugador, juego : Juego) : void
  + liberarPropiedad() : void

}

}

' ==========================================
' RELACIONES UML DE PROPIEDAD
' ==========================================

' HERENCIA - PROPIEDAD EXTIENDE CASILLA
Propiedad --|> Casilla

' ASOCIACION - GUARDA EL JUGADOR PROPIETARIO
Propiedad --> "0..1" Jugador : propietario

' DEPENDENCIA - UTILIZA LA LOGICA DEL JUEGO
Propiedad ..> Juego : <<use>>

' DEPENDENCIA - UTILIZA EL BANCO PARA LOS PAGOS
Propiedad ..> Banco : <<use>>

' DEPENDENCIA - CREA TRANSACCIONES
Propiedad ..> Transaccion : <<create>>

' DEPENDENCIA - UTILIZA LOS TIPOS DE TRANSACCION
Propiedad ..> TipoTransaccion : <<use>>


' ==========================================
' CLASE TABLERO
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class Tablero {

  ' ATRIBUTOS PRIVADOS
  - Lista : ListaCircularDoble<NodoCasilla>
  - Mazo : MazoEventos

  ' ATRIBUTOS PRIVADOS ESTATICOS Y FINALES
  - {static} NombresCasillas : String[] {readOnly}
  - {static} PreciosCasillas : double[] {readOnly}

  ' CONSTRUCTOR PUBLICO
  + Tablero()

  ' METODOS PUBLICOS
  + ObtenerNodo(Posicion : int) : NodoCasilla
  + ObtenerNodoActual(Jugador : Jugador) : NodoCasilla
  + ObtenerCasillaActual(Jugador : Jugador) : Casilla
  + ObtenerSiguiente(Nodo : NodoCasilla, Pasos : int) : NodoCasilla
  + ObtenerAnterior(Nodo : NodoCasilla, Pasos : int) : NodoCasilla
  + getNumeroCasillas() : int
  + MostrarTablero() : void

  ' METODOS PRIVADOS
  - CrearCasilla(i : int) : Casilla
  - EsPosicionEvento(i : int) : boolean

}

}

' ==========================================
' RELACIONES UML DE TABLERO
' ==========================================

' COMPOSICION - EL TABLERO CREA SU LISTA CIRCULAR DOBLE
Tablero *-- "1" ListaCircularDoble : Lista

' COMPOSICION - EL TABLERO CREA SU MAZO DE EVENTOS
Tablero *-- "1" MazoEventos : Mazo

' DEPENDENCIA - EL TABLERO CREA LOS NODOS DE CASILLAS
Tablero ..> NodoCasilla : <<create>>

' DEPENDENCIA - CREA CASILLAS DE EVENTO
Tablero ..> CasillaEvento : <<create>>

' DEPENDENCIA - CREA CASILLAS ESPECIALES
Tablero ..> CasillaEspecial : <<create>>

' DEPENDENCIA - CREA PROPIEDADES
Tablero ..> Propiedad : <<create>>

' DEPENDENCIA - UTILIZA LA CLASE BASE CASILLA
Tablero ..> Casilla : <<use>>

' DEPENDENCIA - CONSULTA POSICIONES Y VALORES
Tablero ..> Constantes : <<use>>

' DEPENDENCIA - CONSULTA LA POSICION DEL JUGADOR
Tablero ..> Jugador : <<use>>

' DEPENDENCIA - UTILIZA LOS TIPOS DE CASILLAS ESPECIALES
Tablero ..> TipoCasillaEspecial : <<use>>


' ==========================================
' ENUM TIPOEVENTO
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

enum TipoEvento {
  RECIBIR_DINERO
  PAGAR_DINERO
  AVANZAR
  RETROCEDER
  PERDER_TURNO
  IR_A_CASILLA
  IR_AL_D3
  SALIDA_LIBRE_D3
}

}


' ==========================================
' ENUM TIPOCASILLAESPECIAL
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

enum TipoCasillaEspecial {
  SALIDA
  VISITA_D3
  ESPECIAL
  IR_AL_D3
}

}


' ==========================================
' ENUM TIPOTRANSACCION
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

enum TipoTransaccion {
  COMPRA_PROPIEDAD
  PAGO_ALQUILER
  PAGO_BANCO
  PAGO_ENTRE_JUGADORES
  GANANCIA_EVENTO
  PERDIDA_EVENTO
  PREMIO_POR_INICIO
  --
  + getNombre() : String
}

}


' ==========================================
' CLASE TRANSACCION
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class Transaccion {

  ' ATRIBUTOS PRIVADOS
  - identificador : String
  - numeroTurno : int
  - tipo : TipoTransaccion
  - jugadorOrigen : String
  - jugadorDestino : String
  - monto : double
  - descripcion : String
  - fechaHora : LocalDateTime

  ' CONSTRUCTORES PUBLICOS
  + Transaccion(identificador : String, numeroTurno : int, tipo : TipoTransaccion, jugadorOrigen : String, jugadorDestino : String, monto : double, descripcion : String)
  + Transaccion(identificador : String, numeroTurno : int, tipo : String, jugadorOrigen : String, jugadorDestino : String, monto : double, descripcion : String)

  ' METODOS PUBLICOS
  + getIdentificador() : String
  + getNumeroTurno() : int
  + getTipo() : TipoTransaccion
  + getJugadorOrigen() : String
  + getJugadorDestino() : String
  + getMonto() : double
  + getDescripcion() : String
  + getFechaHora() : LocalDateTime
  + getResumen() : String
  + toString() : String

}

}

' ==========================================
' RELACIONES UML DE TRANSACCION
' ==========================================

' ASOCIACION - ALMACENA EL TIPO DE TRANSACCION
Transaccion --> "1" TipoTransaccion : tipo

' DEPENDENCIA - UTILIZA LA FECHA Y HORA
Transaccion ..> LocalDateTime : <<use>>

' DEPENDENCIA - FORMATEA LA FECHA Y HORA
Transaccion ..> DateTimeFormatter : <<use>>


' ==========================================
' CLASE CASILLAEVENTO
' PAQUETE LOGICAJUEGO
' ==========================================

package "LogicaJuego" {

class CasillaEvento {

  ' ATRIBUTOS PRIVADOS
  - Mazo : MazoEventos
  - Carta : CartaEvento

  ' CONSTRUCTOR PUBLICO
  + CasillaEvento(Nombre : String, Mazo : MazoEventos)

  ' METODOS PUBLICOS
  + ejecutar(Jugador : Jugador, Juego : Juego) : void
  + ObtenerCarta() : CartaEvento

}

}

' ==========================================
' RELACIONES UML DE CASILLAEVENTO
' ==========================================

' HERENCIA - CASILLAEVENTO EXTIENDE CASILLA
CasillaEvento --|> Casilla

' ASOCIACION - UTILIZA EL MAZO COMPARTIDO
CasillaEvento --> "1" MazoEventos : Mazo

' ASOCIACION - GUARDA LA ULTIMA CARTA OBTENIDA
CasillaEvento --> "0..1" CartaEvento : Carta

' DEPENDENCIA - UTILIZA JUGADOR
CasillaEvento ..> Jugador : <<use>>

' DEPENDENCIA - UTILIZA JUEGO
CasillaEvento ..> Juego : <<use>>


@enduml
